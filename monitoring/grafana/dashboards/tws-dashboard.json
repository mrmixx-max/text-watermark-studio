      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Detection Score Distribution (|Z|)",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(tws_detection_score_bucket[5m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
