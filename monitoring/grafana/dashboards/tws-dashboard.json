      },
      "title": "Detection Verdicts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(tws_detection_verdict_total[5m])) by (verdict)",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
