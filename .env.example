AI_WM_APP_NAME=Text Watermark Studio v8
AI_WM_ENV=development
AI_WM_HOST=127.0.0.1
AI_WM_PORT=8080
AI_WM_CORS_ORIGINS=*
AI_WM_LOG_LEVEL=INFO
AI_WM_API_KEY=
AI_WM_RATE_LIMIT_REQUESTS=60
AI_WM_RATE_LIMIT_WINDOW_SEC=60
AI_WM_REDIS_URL=redis://localhost:6379/0
AI_WM_STREAM_KEY=tws:stream:jobs
AI_WM_DLQ_STREAM_KEY=tws:stream:jobs:dlq
AI_WM_STREAM_GROUP=tws-workers
AI_WM_CONSUMER_NAME=studio-consumer-1
AI_WM_MIN_IDLE_MS=60000
AI_WM_MAX_RETRIES=3
AI_WM_RETRY_BACKOFF_MS=5000
AI_WM_STREAM_MAXLEN=10000
AI_WM_ENABLE_METRICS=true


# LLM rewriting providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REWRITE_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REWRITE_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_REWRITE_MODEL=claude-sonnet-4-20250514
